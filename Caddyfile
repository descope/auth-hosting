{
	http_port {$PORT:8080}
	auto_https off
	debug
	log {
		format console
		output stdout
		level info
	}
}

http:// {
	log
	encode gzip

	# Per-request nonce for the enforcing policy. config/cspPlugin.js bakes
	# {{placeholder "http.vars.nonce"}} into index.html when a build sets
	# ADD_CSP (FedRAMP images), and the templates directive below substitutes
	# this value on every request. A nonce baked into a static file would be
	# identical for every visitor, which is no better than 'unsafe-inline'.
	vars {
		nonce {http.request.uuid}
	}

	# The document carries that nonce, so it must never be reused: file_server
	# would otherwise serve it with its default ETag/Last-Modified and let a
	# browser or shared cache hand one visitor's nonce to the next. Static
	# assets, which carry no nonce, keep their caching.
	@document not path *.js *.mjs *.css *.map *.json *.txt *.xml *.ico *.svg *.png *.jpg *.jpeg *.gif *.webp *.avif *.woff *.woff2 *.ttf *.eot *.mp4 *.webm *.wasm
	header @document Cache-Control "no-store"

	# Framing protection, always enforced. It cannot travel in the meta tag —
	# browsers ignore frame-ancestors there — so an ADD_CSP build carries its
	# whole policy in the meta except this one directive, which has to be a
	# header. Without it a FedRAMP image would have no clickjacking protection
	# at all, which is also ZAP rule 10020.
	#
	# Unlike the Vercel path this one cannot read the project's
	# allowAuthHostingIframeEmbedding setting. A deployment that must allow
	# embedding overrides both vars together; the defaults refuse it.
	#
	# Keep CSP_HEADER to frame-ancestors only on an ADD_CSP build: a second full
	# policy would also have to be satisfied, and it cannot know the per-request
	# nonce, so it would block the app's own bootstrap script.
	# CSP_REPORT_ONLY is for deployments that are measuring rather than
	# enforcing. Empty by default so it stays out of the way of an ADD_CSP
	# build, whose meta tag already enforces the full policy with a nonce this
	# header cannot know — it would report a violation for every element that
	# nonce admits. A container that is not enforcing sets it to the policy it
	# wants to measure, adding the backend and content origins for its
	# environment; mkCsp in src/shared/csp.js builds the same string.
	header {
		Content-Security-Policy "{$CSP_HEADER:frame-ancestors 'self'}"
		Content-Security-Policy-Report-Only "{$CSP_REPORT_ONLY:}"
		X-Frame-Options "{$X_FRAME_OPTIONS:SAMEORIGIN}"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /login* {
		uri strip_prefix /login
		root * {$WWW_ROOT:/www}
		try_files {path} /index.html
		# Only index.html is a template — running the app bundles through the
		# template engine would break on any "{{" in the minified JS.
		templates /index.html
		file_server browse
	}

	vars {
		REACT_APP_DESCOPE_BASE_URL '{$REACT_APP_DESCOPE_BASE_URL:https://api.descope.com}'
		REACT_APP_CONTENT_BASE_URL '{$REACT_APP_CONTENT_BASE_URL:https://api.descope.com/pages}'
		REACT_APP_USE_ORIGIN_BASE_URL '{$REACT_APP_USE_ORIGIN_BASE_URL:false}'
		REACT_APP_FAVICON_URL_TEMPLATE '{$REACT_APP_FAVICON_URL_TEMPLATE:https://api.descope.com/pages/\{projectId}}/v2-beta/\{ssoAppId}/assets/favicon.ico'
		REACT_APP_DEFAULT_FAVICON_URL '{$REACT_APP_DEFAULT_FAVICON_URL:https://imgs.descope.com/auth-hosting/favicon.svg}'
		REACT_APP_FLOW_WIDTH '{$REACT_APP_FLOW_WIDTH}'
		REACT_APP_FLOW_HEIGHT '{$REACT_APP_FLOW_HEIGHT}'
		DESCOPE_PROJECT_ID '{$DESCOPE_PROJECT_ID}'
		DESCOPE_FLOW_ID '{$DESCOPE_FLOW_ID}'
		LOGGER '{$LOGGER:false}'
	}

	handle /login/env.js {
		uri strip_prefix /login
		# respond defaults to text/plain, which the browser used to sniff and run
		# anyway. X-Content-Type-Options: nosniff above stops that, so the type
		# has to be stated or window.env never gets defined. templates only
		# processes text/html and text/plain by default, so it has to be told
		# about the new type as well or it emits the placeholders verbatim.
		header Content-Type "text/javascript; charset=utf-8"
		templates {
			mime text/javascript application/javascript
		}
		respond `
window.env = {
	REACT_APP_DESCOPE_BASE_URL: {{ placeholder "http.vars.REACT_APP_DESCOPE_BASE_URL" }},
	REACT_APP_CONTENT_BASE_URL: {{ placeholder "http.vars.REACT_APP_CONTENT_BASE_URL" }},
	REACT_APP_USE_ORIGIN_BASE_URL: {{ placeholder "http.vars.REACT_APP_USE_ORIGIN_BASE_URL" }},
	REACT_APP_FAVICON_URL_TEMPLATE: {{ placeholder "http.vars.REACT_APP_FAVICON_URL_TEMPLATE" }},
	REACT_APP_DEFAULT_FAVICON_URL: {{ placeholder "http.vars.REACT_APP_DEFAULT_FAVICON_URL" }},
	REACT_APP_FLOW_WIDTH: {{ placeholder "http.vars.REACT_APP_FLOW_WIDTH" }},
	REACT_APP_FLOW_HEIGHT: {{ placeholder "http.vars.REACT_APP_FLOW_HEIGHT" }},
	DESCOPE_PROJECT_ID: {{ placeholder "http.vars.DESCOPE_PROJECT_ID" }},
	DESCOPE_FLOW_ID: {{ placeholder "http.vars.DESCOPE_FLOW_ID" }},
	LOGGER: {{ placeholder "http.vars.LOGGER" }}
};`
		}

		# Optional: Redirect root to /login
		handle {
			redir / /login permanent
		}
	}

	*:{$METRICS_PORT:2000} {
		log
		metrics {$METRICS_PATH:/metrics}
	}
